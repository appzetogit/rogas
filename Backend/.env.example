# Copy to .env and fill in. Never commit .env.
# Only the payments variables are listed here; see src/modules/payments/README.md for what each one does.

# Public addresses (providers call the API back; customers return to the app)
API_PUBLIC_URL=https://api.example.com
APP_PUBLIC_URL=https://app.example.com

# Przelewy24 (Poland)
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=true

# Stripe (other countries)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Development only: adds a "Test payment" option that always succeeds. Ignored when NODE_ENV=production.
# PAYMENTS_MODE=mock
